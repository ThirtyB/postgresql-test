# PostgreSQL 数据库配置示例
# 复制此文件为 .env 并修改相应的配置值

# 数据库主机地址
DB_HOST=192.168.16.106

# 数据库端口
DB_PORT=5432

# 数据库名称
DB_NAME=db1

# 数据库用户名
DB_USER=user1

# 数据库密码
DB_PASSWORD=123456

# JWT安全配置（生产环境必须修改）
# 生成安全密钥命令：openssl rand -base64 32 或 python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secure-production-key-change-this-in-production

# JWT算法（通常不需要修改）
JWT_ALGORITHM=HS256

# JWT令牌过期时间（分钟）
JWT_EXPIRE_MINUTES=30